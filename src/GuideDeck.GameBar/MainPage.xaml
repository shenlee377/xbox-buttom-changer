<Page x:Class="GuideDeck.GameBar.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid Padding="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="GuideDeck" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Steam Guide 綁定實驗工作台" Margin="0,4,0,8"/></StackPanel>
  <Pivot x:Name="Sections" Grid.Row="1">
   <PivotItem Header="狀態"><ScrollViewer><StackPanel Spacing="12">
    <TextBlock Text="原生 Game Bar 保留" FontSize="22"/>
    <TextBlock Text="此 widget 不攔截、不模擬 Guide。Steam 是否仍有響應，需要在您的手把與遊戲中測試。" TextWrapping="Wrap"/>
    <TextBlock Text="設定狀態：未與 Steam 即時同步" Foreground="#FFE1AE" TextWrapping="Wrap"/>
    <TextBlock Text="1. 在 Steam 控制器設定匯出自己的 SDL mapping。&#10;2. 到「mapping」只移除 Guide，保留原始字串。&#10;3. 將結果貼回 Steam（若該版本提供匯入）。&#10;4. 回到「驗收」記錄結果。" TextWrapping="Wrap"/>
    <TextBlock Text="不要停用整個 Steam Input 或 Overlay。若 Steam 未採用 mapping，這條路徑無效，請恢復原始 mapping。" TextWrapping="Wrap"/>
    <TextBlock Text="桌面版可檢查 config.vdf 並進行備份／還原。本 widget 不會偷偷修改 Steam 檔案。" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></PivotItem>
   <PivotItem Header="mapping"><ScrollViewer><StackPanel Spacing="10">
    <TextBlock Text="只移除一行 mapping 裡的 guide:bN" TextWrapping="Wrap"/>
    <Button Content="貼上自己的 mapping" Click="Paste"/>
    <TextBox x:Name="Input" Header="原始 mapping" AcceptsReturn="True" TextWrapping="Wrap" Height="110" TextChanged="InputChanged"/>
    <Button Content="預覽 Guide 移除結果" Click="Preview"/>
    <TextBox x:Name="Output" Header="結果（尚未套用至 Steam）" IsReadOnly="True" TextWrapping="Wrap" Height="110"/>
    <CheckBox x:Name="Consent" Content="了解會移除此 mapping 的 Steam Guide／chord 綁定；效果待測試。"/>
    <Button x:Name="CopyButton" Content="備份原始 mapping 並複製結果" Click="Copy" IsEnabled="False"/>
    <Button Content="複製最近一次備份的原始 mapping" Click="RestoreClipboard"/>
   </StackPanel></ScrollViewer></PivotItem>
   <PivotItem Header="驗收"><ScrollViewer><StackPanel Spacing="10">
    <TextBlock Text="人工觀察記錄，非自動偵測" Foreground="#FFE1AE"/>
    <TextBox x:Name="Context" Header="遊戲／桌面、手把、連接方式、Steam 版本"/>
    <ComboBox x:Name="Scope" Header="情境" SelectedIndex="0"><ComboBoxItem Content="桌面：Steam 未聚焦"/><ComboBoxItem Content="桌面：Steam 已聚焦"/><ComboBoxItem Content="Steam 遊戲"/><ComboBoxItem Content="非 Steam 遊戲"/></ComboBox>
    <StackPanel x:Name="Checks" Spacing="8"/>
    <Button Content="儲存觀察記錄" Click="SaveReport"/>
    <TextBlock Text="其他啟動器尚未實作；此工作台不代表通用第三方 Guide 封鎖。" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></PivotItem>
  </Pivot>
  <TextBlock x:Name="Status" Grid.Row="2" Text="尚未修改設定或剪貼簿。" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Page>
