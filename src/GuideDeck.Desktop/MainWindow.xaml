<Window x:Class="GuideDeck.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GuideDeck · Steam Guide 實驗原型" Width="1080" Height="850" MinWidth="850" MinHeight="640" Background="#111A15" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="GuideDeck" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="保留 Game Bar，研究移除 Steam 的 Guide 響應" Foreground="#B2C7B8" Margin="0,6,0,16"/></StackPanel>
  <Border Grid.Row="1" Background="#3D3420" Padding="16" CornerRadius="8" Margin="0,0,0,18"><TextBlock Text="實驗性 SDL mapping 適配器：可以移除指定 Steam mapping 的 Guide 綁定，尚未保證阻止所有 Steam 輸入路徑。沒有驅動、程序注入或全域按鍵模擬。"/></Border>
  <TabControl Grid.Row="2" Background="#202A25" BorderThickness="0">
   <TabItem Header="Steam 設定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="1　選擇 Steam 設定" FontSize="20"/>
    <WrapPanel Margin="0,8,0,4"><Button Content="偵測 Steam" Click="DetectSteam"/><Button Content="選擇 config.vdf" Click="ChooseConfig"/><Button Content="重新檢查" Click="InspectConfig"/></WrapPanel>
    <TextBox x:Name="ConfigPath" AutomationProperties.Name="Steam config.vdf 路徑" TextChanged="ConfigPathChanged"/>
    <TextBlock x:Name="InspectionStatus" Margin="0,8,0,8"/>
    <ComboBox x:Name="Mappings" DisplayMemberPath="Name" SelectionChanged="MappingChanged" Padding="8" AutomationProperties.Name="控制器 mapping"/>
    <TextBlock Text="2　預覽：只移除 Guide" FontSize="20" Margin="0,20,0,10"/>
    <TextBlock Text="原始 mapping"/><TextBox x:Name="Before" Height="90" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="修改前 mapping"/>
    <TextBlock Text="修改後 mapping" Margin="0,10,0,0"/><TextBox x:Name="After" Height="90" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="修改後 mapping"/>
    <CheckBox x:Name="ExperimentalConsent" Content="我了解這是實驗性修改，會影響此 mapping 的 Steam Guide／組合鍵功能，效果需實測。" Checked="ConsentChanged" Unchecked="ConsentChanged"/>
    <TextBlock Text="先完整離開 Steam。套用只處理這筆 mapping；不修改 Game Bar、Steam Input 開關或 Overlay 開關。" Foreground="#B2C7B8"/>
    <WrapPanel><Button x:Name="ApplyButton" Content="備份並套用" IsEnabled="False" Click="ApplyPatch"/><Button Content="選擇備份並還原" Click="RestorePatch"/><Button Content="開啟備份資料夾" Click="OpenBackups"/></WrapPanel>
    <TextBlock Text="找不到 mapping 時：先在 Steam → 設定 → 控制器 → 測試／設定裝置輸入建立並儲存您自己的 mapping，再回來檢查。選項名稱依版本不同。請勿套用別人的 GUID。" Foreground="#B2C7B8" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="mapping 工作台"><StackPanel Margin="18">
    <TextBlock Text="從自己的 Steam 匯出一行 SDL mapping" FontSize="20"/>
    <TextBlock Text="可先使用 Steam 的複製 mapping 功能，在此預覽，再將結果貼回 Steam。這不會修改全域 SDL 環境變數。" Margin="0,8,0,12"/>
    <TextBox x:Name="MappingInput" Height="130" AcceptsReturn="True" TextChanged="MappingInputChanged" AutomationProperties.Name="匯入 SDL mapping"/>
    <WrapPanel><Button Content="從剪貼簿貼上" Click="PasteMapping"/><Button Content="預覽移除 Guide" Click="PreviewMapping"/><Button x:Name="CopyMappingButton" Content="複製結果" Click="CopyMapping" IsEnabled="False"/></WrapPanel>
    <TextBox x:Name="MappingOutput" Height="130" IsReadOnly="True" AutomationProperties.Name="移除 Guide 後的 mapping"/>
    <TextBlock Text="複製不代表 Steam 已採用，也不代表 Guide 已被阻止。請保留原始 mapping，並完成右側驗收。" Margin="0,14,0,0" Foreground="#B2C7B8"/>
   </StackPanel></TabItem>
   <TabItem Header="遊戲驗收"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="實際效果，由這個環境的測試確認" FontSize="20"/>
    <TextBlock Text="本頁記錄您的觀察，不是程式自動偵測。若任何項目失敗，保留記錄並還原設定。" Margin="0,8,0,14"/>
    <TextBlock Text="遊戲名稱／桌面"/><TextBox x:Name="GameName"/>
    <TextBlock Text="控制器型號＋連接方式＋Steam 版本（手動填寫）" Margin="0,10,0,0"/><TextBox x:Name="EnvironmentNotes"/>
    <TextBlock Text="測試情境" Margin="0,10,0,0"/><ComboBox x:Name="TestScope" SelectedIndex="0" Padding="8"><ComboBoxItem Content="桌面，Steam 未聚焦"/><ComboBoxItem Content="桌面，Steam 已聚焦"/><ComboBoxItem Content="Steam 啟動的遊戲"/><ComboBoxItem Content="非 Steam 遊戲"/></ComboBox>
    <TextBlock Text="每項請選：未測試／通過／失敗" Margin="0,16,0,8"/>
    <StackPanel x:Name="ChecksPanel"/>
    <Button Content="儲存本次觀察記錄" Click="SaveValidation" HorizontalAlignment="Left"/>
    <TextBlock Text="測試結果只適用於填寫的環境。Steam、Windows、手把連接方式或設定變更後，需重新測試。" Foreground="#B2C7B8" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Game Bar"><StackPanel Margin="18">
    <TextBlock Text="沿用 Windows 原生 Guide → Game Bar" FontSize="20"/>
    <TextBlock Text="請保留控制器開啟 Game Bar 的 Windows 設定。本原型不攔截、不補送 Guide，也不修改 Windows 設定。" Margin="0,12,0,12"/>
    <Button Content="開啟 Windows Game Bar 設定" Click="OpenGameBarSettings" HorizontalAlignment="Left"/>
    <TextBlock Text="專案附有 UWP Game Bar widget：可在遊戲中使用相同的 mapping 工作台，保留原始字串、產生 Guide 移除結果及儲存手動驗收記錄。需要在 Windows 建置並部署；桌面程式不會自動安裝 widget。" Margin="0,20,0,0"/>
    <TextBlock Text="其他啟動器：尚未實作。不能把 Steam 的設定適配器當成通用第三方封鎖功能。" Margin="0,20,0,0" Foreground="#E8C98B"/>
   </StackPanel></TabItem>
  </TabControl>
  <Border Grid.Row="3" Background="#202A25" Padding="12" Margin="0,16,0,0" CornerRadius="6"><TextBlock x:Name="Status" Text="尚未修改任何設定。請先偵測 Steam 或選擇 config.vdf。" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
