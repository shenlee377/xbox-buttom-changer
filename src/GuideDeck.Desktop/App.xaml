<Application x:Class="GuideDeck.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#202A25"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F6F3"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="#D8F2DE"/><Setter Property="Foreground" Value="#15241B"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#101A15"/><Setter Property="Foreground" Value="#ECF4EE"/><Setter Property="BorderBrush" Value="#4D6856"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F6F3"/><Setter Property="Margin" Value="0,10,0,10"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/></Style>
  </Application.Resources>
</Application>
